# Copy to .env. Never commit .env or share its secret values.
SECRET_KEY=replace_with_a_long_random_secret

# PostgreSQL 15 - local Docker Compose service is exposed on localhost:5432
DATABASE_URL=postgresql://rgai:rgai@localhost:5432/researchgapai

# Neo4j 5 - local Docker Compose Bolt endpoint
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchgap

# LLM provider (Groq example; update model to one currently enabled for your account)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace_with_your_provider_key
LLM_MODEL=openai/gpt-oss-120b

# Scholarly APIs / optional settings
S2_API_KEY=
CONTACT_EMAIL=researchgapai@example.com
MIN_PAPERS=12
MAX_PAPERS=60
